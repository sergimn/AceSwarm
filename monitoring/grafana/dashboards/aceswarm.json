{
  "uid": "aceswarm-overview",
  "title": "Ace Swarm",
  "description": "Stream health, peers and network paths of an Ace Swarm stack.",
  "tags": [
    "aceswarm"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(aceswarm_stream_info, stream)",
          "refId": "streams"
        },
        "definition": "label_values(aceswarm_stream_info, stream)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Streams live",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(aceswarm_stream_state{state=\"playing\"} == 1) or vector(0)",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Streams configured",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(aceswarm_streams)",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Engines running",
      "id": 41,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Engine containers running now. Each enabled stream has an engine of its own, plus its hot standbys on other paths. With \"One engine per path\" on, each path has one shared engine instead, for all its streams and their standbys; while a replaced shared engine's streams move, both count. Engines kept to retry a move, and shared engines that stay a while after their last stream left, count too. From the container runtime, every ENGINE_STATS_SECONDS (15 s).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(aceswarm_engines)",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Network paths up",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(aceswarm_path_up)",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Recoveries in range",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(aceswarm_stream_recoveries_total[$__range])) or vector(0)",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "row",
      "title": "Viewers",
      "id": 33,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Who is watching what",
      "id": 34,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Players showing a stream full screen right now. A viewer is a random id the page makes up when it loads and keeps only in memory, so every visit is a new viewer; the device is a rough guess from the browser.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "aceswarm_viewer_watching * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "stream": true,
              "service": true
            },
            "indexByName": {
              "name": 0,
              "viewer": 1,
              "device": 2
            },
            "renameByName": {
              "name": "Stream",
              "viewer": "Viewer",
              "device": "Device"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Stream",
            "desc": false
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Viewers per stream",
      "id": 35,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "aceswarm_stream_viewers * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"} > 0",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "state-timeline",
      "title": "What each viewer watched",
      "id": 36,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One lane per viewer and stream: when each player showed which stream.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "aceswarm_viewer_watching * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{viewer}} ({{device}}): {{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "watching"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      }
    },
    {
      "type": "row",
      "title": "Stream stability",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Delivering new frames",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "aceswarm_stream_up * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      },
      "description": "Green while the stream produces new video frames (aceswarm_stream_up)."
    },
    {
      "type": "bargauge",
      "title": "Availability in range",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "avg_over_time(aceswarm_stream_up[$__range]) * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": false,
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Recoveries per hour",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (action) (increase(aceswarm_stream_recoveries_total{stream=~\"$stream\"}[1h]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{action}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Recovery actions: restart-pipeline, restart-engine and switch-path."
    },
    {
      "type": "timeseries",
      "title": "Age of the last new frame",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "aceswarm_stream_last_frame_age_seconds * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Pipeline frame rate",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "aceswarm_pipeline_fps{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{stream}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Peers",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Peers sending data",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "expr": "aceswarm_stream_peers{kind=\"active\"} * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Peers whose traffic grew during the last sample, measured on the gateway."
    },
    {
      "type": "timeseries",
      "title": "Download speed",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "targets": [
        {
          "expr": "aceswarm_stream_speed_kbytes{direction=\"down\"} * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "KBs"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "bargauge",
      "title": "Peer countries",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "expr": "topk(15, sum by (country) (aceswarm_stream_peer_countries{stream=~\"$stream\"}))",
          "range": false,
          "instant": true,
          "legendFormat": "{{country}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Peers connected",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "expr": "aceswarm_stream_peers{kind=\"connected\"} * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Engines",
      "id": 27,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 65
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Engine memory",
      "id": 28,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Memory used by each engine: a stream's own engine, or a shared engine (named after its path) that every stream on the path plays from. An engine that reaches the limit (dashed) is killed and restarted; raise ENGINE_MEMORY_MB, or lower ENGINE_MEMORY_CACHE_MB (set it if it is 0) if it gets close.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 66
      },
      "targets": [
        {
          "expr": "aceswarm_engine_memory_bytes * on (stream) group_left (name) aceswarm_stream_info{stream=~\"$stream\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "aceswarm_engine_memory_bytes{stream=\"\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{engine}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max(aceswarm_engine_memory_limit_bytes{stream=~\"$stream\"})",
          "range": true,
          "instant": false,
          "legendFormat": "Limit",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Engine memory, share of the limit",
      "id": 29,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
