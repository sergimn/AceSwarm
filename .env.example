# Copy to .env and adjust. Every value has a default in compose.yaml.

# Monitoring profiles: metrics (Prometheus), logs (Alloy + Loki), grafana (dashboards).
# Remove the ones you do not want; the app works without any of them.
COMPOSE_PROFILES=metrics,logs,grafana

# Docker socket. Rootless Docker usually lives at /run/user/<uid>/docker.sock and Podman's
# Docker-compatible API at /run/user/<uid>/podman/podman.sock (enable it with
# `systemctl --user enable --now podman.socket`).
DOCKER_SOCKET=/var/run/docker.sock

# Engines network. Keep false on Docker (internal networks drop traffic to the internet there).
# Set true on Podman, or netavark NATs engine traffic and the gateway can't tell engines apart.
ACESWARM_ENGINES_INTERNAL=false

# Published ports (use values >= 1024 with rootless Docker).
ACESWARM_HTTP_PORT=8080
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# Images. Build locally with `docker compose --profile build build` or pull the published ones.
ACESWARM_IMAGE_PREFIX=ghcr.io/sergimn/aceswarm
ACESWARM_VERSION=latest
ENGINE_IMAGE=ghcr.io/sergimn/aceswarm-engine:latest

# Engines: memory limit per engine and DNS servers (reached through the selected network path).
# Engine memory use varies a lot (from about 250 MB to over 800 MB per stream in testing) and an
# engine that reaches the limit is killed and restarted, which interrupts its stream. The Grafana
# dashboard ("Engines" row) shows each engine's use against the limit, and Prometheus alerts when an
# engine stays above 85% of it or gets killed. Raise this if that happens.
ENGINE_MEMORY_MB=2048
ENGINE_DNS=1.1.1.1,9.9.9.9
# Engines can't reach private, link-local or local addresses (the host, its published ports, the
# LAN). List private networks they may reach anyway as CIDRs (/32 for one host), such as LAN peers
# (192.168.1.0/24) or a private resolver used in ENGINE_DNS (192.168.1.1/32).
# Only engines on the direct path reach them: on a WireGuard path, that traffic
# goes into the tunnel.
ENGINE_ALLOWED_PRIVATE=

# Previews: "video" (low-res live previews) or "keyframes" (decodes key frames only; use this on a
# Raspberry Pi, which has no hardware H.264 decoder).
PREVIEW_MODE=video
HLS_TMPFS_SIZE=512m

# Network paths: "sticky-best" keeps a stream on its path until the path fails, then moves it to the
# best one; "round-robin" spreads new streams over the paths that are up.
PATH_STRATEGY=sticky-best

# "One engine per path" (a switch under Streams in the UI) lets every stream on a network path share
# one engine, which needs much less memory. The shared engine keeps running when one stream fails:
# that stream only restarts its own session. The engine is replaced (make-before-break, so the other
# streams keep their picture) when the stream someone watches full screen fails, or when more than
# SHARED_ENGINE_MAX_FAILURES of its streams fail within SHARED_ENGINE_FAILURE_WINDOW_SECONDS.
SHARED_ENGINE_MAX_FAILURES=2
SHARED_ENGINE_FAILURE_WINDOW_SECONDS=60
# Players report the stream they show full screen this often; one that misses two reports no longer
# counts as watching. Viewers are random ids that last one page visit (nothing is stored in the browser).
VIEWER_PING_SECONDS=60

# Retention of the monitoring data.
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=2GB
LOKI_RETENTION=720h

# Use iptables-legacy if the host kernel has no nf_tables support.
IPTABLES=iptables
