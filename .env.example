# Copy to .env and adjust. Every value has a default in compose.yaml.

# Monitoring profiles: metrics (Prometheus), logs (Alloy + Loki), grafana (dashboards).
# Remove the ones you do not want; the app works without any of them.
COMPOSE_PROFILES=metrics,logs,grafana

# Docker socket. Rootless Docker usually lives at /run/user/<uid>/docker.sock.
DOCKER_SOCKET=/var/run/docker.sock

# Published ports (use values >= 1024 with rootless Docker).
ACESWARM_HTTP_PORT=8080
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# Images. Build locally with `docker compose build` or pull the published ones.
ACESWARM_IMAGE_PREFIX=ghcr.io/sergimn/aceswarm
ACESWARM_VERSION=latest
ENGINE_IMAGE=ghcr.io/sergimn/aceswarm-engine:latest

# Engines: memory limit per engine and DNS servers (reached through the selected network path).
ENGINE_MEMORY_MB=768
ENGINE_DNS=1.1.1.1,9.9.9.9

# Previews: "video" (low-res live previews) or "keyframes" (decodes key frames only; use this on a
# Raspberry Pi, which has no hardware H.264 decoder).
PREVIEW_MODE=video
HLS_TMPFS_SIZE=512m

# Network paths: "sticky-best" keeps a stream on its path until the path fails, then moves it to the
# best one; "round-robin" spreads new streams over the paths that are up.
PATH_STRATEGY=sticky-best

# Retention of the monitoring data.
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=2GB
LOKI_RETENTION=720h

# Use iptables-legacy if the host kernel has no nf_tables support.
IPTABLES=iptables
