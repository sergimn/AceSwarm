# Copy to .env and adjust. Every value has a default in compose.yaml.

# Monitoring profiles: metrics (Prometheus), logs (Alloy + Loki), grafana (dashboards).
# Remove the ones you do not want; the app works without any of them.
COMPOSE_PROFILES=metrics,logs,grafana

# Docker socket. Rootless Docker usually lives at /run/user/<uid>/docker.sock and Podman's
# Docker-compatible API at /run/user/<uid>/podman/podman.sock (enable it with
# `systemctl --user enable --now podman.socket`).
DOCKER_SOCKET=/var/run/docker.sock
# On Podman or rootless Docker, comment out the line above and use this one instead. It builds
# the path from XDG_RUNTIME_DIR (/run/user/<uid>), so no UID is hardcoded. For rootless Docker,
# change the end of the path to docker.sock.
#DOCKER_SOCKET=${XDG_RUNTIME_DIR}/podman/podman.sock

# Engines network. Keep false on Docker (internal networks drop traffic to the internet there).
# Set true on Podman, or netavark NATs engine traffic and the gateway can't tell engines apart.
ACESWARM_ENGINES_INTERNAL=false

# Published ports (use values >= 1024 with rootless Docker).
ACESWARM_HTTP_PORT=8080
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# Images. Build locally with `docker compose --profile build build` or pull the published ones.
ACESWARM_IMAGE_PREFIX=ghcr.io/sergimn/aceswarm
ACESWARM_VERSION=latest
ENGINE_IMAGE=ghcr.io/sergimn/aceswarm-engine:latest

# Engines: memory cache, memory limit and DNS servers (reached through the selected network path).
# ENGINE_MEMORY_CACHE_MB caps the stream data an engine keeps in memory. An engine grows until it
# holds that much (a few minutes with 128 MB, longer with more), then stays at about the cache
# size + 150 MB: about 275 MB with 128. 0 leaves the size to the engine: engines then grow for
# over an hour, to about 1.7 GB each in testing, so also raise ENGINE_MEMORY_MB, to 2048 or more,
# or set it to 0. 64 to 1024 MB all played the same in testing, so a bigger cache mostly costs
# memory. The "Engines" dashboard row shows how full each engine's cache is.
ENGINE_MEMORY_CACHE_MB=128
# ENGINE_MEMORY_MB is the memory limit per engine. An engine that reaches it is killed and restarted,
# which interrupts its stream. The Grafana dashboard ("Engines" row) shows each engine's use against
# the limit, and Prometheus alerts when an engine stays above 85% of it or gets killed. The limit
# needs 256 MB of room besides the cache, and has to keep an engine with a full cache (the cache +
# up to 200 MB) under that alert. The controller refuses a limit that is too small and names the
# minimum: 386 for a 128 MB cache, 537 for 256, 838 for 512, 1139 for 768, 1440 for 1024. 0 sets
# no limit.
# Both settings apply to engines started after the change. Run `docker compose up -d` so the
# controller picks them up, then Disable and Enable each stream under Streams to recreate its
# engine. With One engine per path on, press Restart on one stream of each path instead: that
# replaces the path's engine.
ENGINE_MEMORY_MB=512
ENGINE_DNS=1.1.1.1,9.9.9.9
# Engines can't reach private, link-local or local addresses (the host, its published ports, the
# LAN). List private networks they may reach anyway as CIDRs (/32 for one host), such as LAN peers
# (192.168.1.0/24) or a private resolver used in ENGINE_DNS (192.168.1.1/32).
# Only engines on the direct path reach them: on a WireGuard path, that traffic
# goes into the tunnel.
ENGINE_ALLOWED_PRIVATE=

# Previews: "video" (low-res live previews) or "keyframes" (decodes key frames only; use this on a
# Raspberry Pi, which has no hardware H.264 decoder).
PREVIEW_MODE=video
HLS_TMPFS_SIZE=512m

# Network paths: "sticky-best" keeps a stream on its path until the path fails, then moves it to the
# best one; "round-robin" spreads new streams over the paths that are up.
PATH_STRATEGY=sticky-best

# A stream whose move to a new engine fails keeps that engine and tries again on it, since a new
# one would start from no peers. At most this many streams keep one at once (each is an engine
# more); 0 turns it off.
MAX_KEPT_ENGINES=2

# "Hot standby on other paths" (a switch under Streams in the UI, on by default) keeps every playing
# stream running on each other network path too: on an engine of its own there, or with "One
# engine per path" on, a session on that path's shared engine. When the stream's engine or path
# fails, it fails over to a standby that already has the stream, within seconds. It only helps with
# more than one path (add a WireGuard profile), and each standby is an engine more (or a session
# more on a shared one), downloading the stream all the time. STANDBY_MAX_PATHS limits each stream
# to its best few other paths (0: all of them). A stream with a hot standby fails over once no new
# video came for STANDBY_FAILOVER_SECONDS, before it counts as stalled (STALL_SECONDS, 20 by default).
STANDBY_MAX_PATHS=0
STANDBY_FAILOVER_SECONDS=8

# "One engine per path" (a switch under Streams in the UI) lets every stream on a network path share
# one engine, which needs much less memory. The shared engine keeps running when one stream fails:
# that stream only restarts its own session. The engine is replaced (make-before-break, so the other
# streams keep their picture) when the stream someone watches full screen fails, or when more than
# SHARED_ENGINE_MAX_FAILURES of its streams fail within SHARED_ENGINE_FAILURE_WINDOW_SECONDS.
SHARED_ENGINE_MAX_FAILURES=2
SHARED_ENGINE_FAILURE_WINDOW_SECONDS=60
# Players report the stream they show full screen this often; one that misses two reports no longer
# counts as watching. Viewers are random ids that last one page visit (nothing is stored in the browser).
VIEWER_PING_SECONDS=60

# Retention of the monitoring data.
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=2GB
LOKI_RETENTION=720h

# Use iptables-legacy if the host kernel has no nf_tables support.
IPTABLES=iptables
